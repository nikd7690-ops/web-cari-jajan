# MongoDB Atlas connection string
MONGODB_URI=

# next-auth
NEXTAUTH_SECRET=
NEXTAUTH_URL=

# Token untuk APK (fallback ke NEXTAUTH_SECRET bila kosong)
JWT_SECRET=

# Google Gemini (AI menu draft)
GEMINI_API_KEY=
GEMINI_MODEL=

# Vercel Blob (unggah foto warung)
BLOB_READ_WRITE_TOKEN=

# URL muat APK (Capacitor). Default sudah diatur ke domain produksi di capacitor.config.ts
CAP_SERVER_URL=

# Demo account
DEMO_EMAIL=
DEMO_PASSWORD=
