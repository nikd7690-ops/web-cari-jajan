# ==============================================================================
# KONFIGURASI APLIKASI NATIVE ANDROID (CARI JAJAN)
# ==============================================================================
# Petunjuk:
# 1. Salin berkas ini menjadi .env di dalam folder native-android/ :
#    cp .env.example .env
# 2. Sesuaikan variabel di bawah sesuai kebutuhan deployment Anda.
# 3. Jalankan build: ./gradlew assembleDebug
# ==============================================================================

# 1. URL Backend REST API (Next.js App Router)
# Default produksi: https://web-cari-jajan.vercel.app
# Untuk pengujian Android Emulator lokal: http://10.0.2.2:3000
# Untuk pengujian HP fisik via Wi-Fi lokal: http://192.168.1.xxx:3000
API_BASE_URL=https://web-cari-jajan.vercel.app

# 2. Nama Aplikasi (Label teks yang tampil di layar HP pengguna)
APP_NAME=Cari Jajan

# 3. Application ID / Package Name Android (Opsional)
APPLICATION_ID=com.carijajan.app

# 4. URL Style Vector Tile Peta (OpenFreeMap Liberty Style)
MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# 5. Ikon Aplikasi (Launcher Icon)
# Nilai bawaan: @mipmap/ic_launcher
# Jika ingin mengganti ikon, taruh gambar di folder app/src/main/res/drawable/
# lalu ubah menjadi misal: @drawable/nama_ikon_anda
APP_ICON=@drawable/icon
